#!/usr/bin/env bash
set -euo pipefail

exec 9>"${XDG_RUNTIME_DIR:-/tmp}/hypr-monitor-brightness.lock"
flock -n 9 || exit 0

display_name() {
  case "$1" in
    1) printf 'HDMI-A-2 - ASUS VG249QL3A' ;;
    2) printf 'DP-6 - MSI MAG 275QF E21' ;;
  esac
}

brightness() {
  local vcp code type current maximum
  read -r vcp code type current maximum < <(ddcutil --display "$1" getvcp 10 --terse)
  [[ "$current" =~ ^[0-9]+$ && "$maximum" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$current"
}

displays_for() {
  if [[ "$1" == "all" ]]; then
    printf '1\n2\n'
  else
    printf '%s\n' "$1"
  fi
}

list_targets() {
  local hdmi dp
  hdmi="$(brightness 1)"
  dp="$(brightness 2)"
  printf 'all\tAll displays - %s%% / %s%%\n' "$hdmi" "$dp"
  printf '1\t%s - %s%%\n' "$(display_name 1)" "$hdmi"
  printf '2\t%s - %s%%\n' "$(display_name 2)" "$dp"
}

apply_brightness() {
  local target="$1" operation="$2" value="$3" display current next summary=""

  while IFS= read -r display; do
    current="$(brightness "$display")"
    if [[ "$operation" == "adjust" ]]; then
      next=$((current + value))
    else
      next="$value"
    fi
    ((next < 1)) && next=1
    ((next > 100)) && next=100
    ddcutil --display "$display" setvcp 10 "$next" >/dev/null
    summary+="$(display_name "$display"): $next%"$'\n'
  done < <(displays_for "$target")

  notify-send --app-name Brightness 'Brightness updated' "${summary%$'\n'}"
}

if [[ "${1:-}" == "--list" ]]; then
  list_targets
  exit
fi

if [[ "${1:-}" == "--adjust" ]]; then
  apply_brightness "${2:?target required}" adjust "${3:?delta required}"
  exit
fi

if [[ "${1:-}" == "--set" ]]; then
  apply_brightness "${2:?target required}" set "${3:?value required}"
  exit
fi

target="$(
  list_targets | fuzzel \
    --dmenu \
    --prompt 'Brightness > ' \
    --with-nth=2 \
    --only-match \
    --no-sort \
    --minimal-lines
)" || exit 0
target="${target%%$'\t'*}"

action="$(
  printf '%s\n' \
    $'adjust:5\tIncrease 5%' \
    $'adjust:-5\tDecrease 5%' \
    $'set:25\tSet 25%' \
    $'set:50\tSet 50%' \
    $'set:75\tSet 75%' \
    $'set:100\tSet 100%' | fuzzel \
      --dmenu \
      --prompt 'Brightness > ' \
      --with-nth=2 \
      --only-match \
      --no-sort \
      --minimal-lines
)" || exit 0

operation="${action%%:*}"
value="${action#*:}"
value="${value%%$'\t'*}"
apply_brightness "$target" "$operation" "$value"
