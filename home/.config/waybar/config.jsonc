{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,
  "on-sigusr1": "toggle",
  "on-sigusr2": "reload",
  "modules-left": [
    "custom/system",
    "hyprland/window",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "mpris",
    "custom/cava"
  ],
  "modules-right": [
    "privacy",
    "tray",
    "bluetooth",
    "network",
    "wireplumber",
    "group/telemetry",
    "clock"
  ],
  "hyprland/workspaces": {
    "all-outputs": true,
    "active-only": false,
    "format": "{name}",
    "on-click": "activate"
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 32,
    "separate-outputs": true
  },
  "clock": {
    "format": "{:%a %b %d  %H:%M}",
    "format-alt": "{:%Y-%m-%d %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },
  "mpris": {
    "format": "{status_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "tooltip-format": "{player}: {dynamic}",
    "max-length": 30,
    "status-icons": {
      "playing": "▶",
      "paused": "Ⅱ",
      "stopped": "■"
    },
    "on-click": "playerctl play-pause",
    "on-click-middle": "playerctl previous",
    "on-click-right": "playerctl next"
  },
  "custom/cava": {
    "exec": "waybar-cava",
    "return-type": "json",
    "restart-interval": 2,
    "tooltip": false,
    "on-click": "ghostty -e cava"
  },
  "group/telemetry": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 180,
      "transition-left-to-right": false,
      "children-class": "telemetry-detail"
    },
    "modules": [
      "custom/control-center",
      "custom/codexbar",
      "cpu",
      "memory"
    ]
  },
  "cpu": {
    "interval": 3,
    "format": " {usage}%",
    "states": {
      "warning": 70,
      "critical": 90
    },
    "on-click": "ghostty -e btop"
  },
  "memory": {
    "interval": 3,
    "format": " {percentage}%",
    "states": {
      "warning": 70,
      "critical": 90
    },
    "on-click": "ghostty -e btop"
  },
  "network": {
    "interval": 5,
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format": "{ifname}: {ipaddr}",
    "tooltip-format-wifi": "{essid} · {signalStrength}%\n{ifname}: {ipaddr}"
  },
  "wireplumber": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "on-click": "hypr-audio-output",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5,
    "format-icons": [
      "",
      "",
      ""
    ],
    "tooltip-format": "Volume: {volume}% · click to choose output"
  },
  "custom/codexbar": {
    "exec": "codexbar --color-low '#888888' --color-mid '#b4b4b4' --color-high '#d4d4d4' --color-critical '#e5484d'",
    "return-type": "json",
    "interval": 300,
    "signal": 12,
    "tooltip": true,
    "on-click": "xdg-open https://chatgpt.com/codex/settings/usage"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "",
    "format-connected-battery": " {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
    "on-click": "hypr-bluetooth"
  },
  "privacy": {
    "icon-spacing": 4,
    "icon-size": 12
  },
  "tray": {
    "icon-size": 15,
    "spacing": 8
  },
  "custom/system": {
    "format": "󰀻",
    "tooltip": true,
    "on-click": "hypr-menu system",
    "tooltip-format": "System menu"
  },
  "reload_style_on_change": true,
  "custom/control-center": {
    "format": "󰒓",
    "tooltip-format": "Control Center · hover for Codex usage, CPU and memory"
  }
}
